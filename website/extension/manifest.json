{
  "manifest_version": 3,
  "name": "SatyaGov Traffic Light",
  "version": "1.0",
  "description": "Evaluates active tab risk using the SatyaGov backend.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
